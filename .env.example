# Copia este archivo a .env y ajusta los valores (el .env NO se sube al repositorio)
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# En AWS: IP pública y/o DNS de la instancia EC2, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo si usas HTTPS (con HTTP simple en EC2 déjalo en False)
DJANGO_HTTPS=False
# Origen(es) de confianza para CSRF, ej: http://54.12.34.56
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
DB_NAME=cristorey
DB_USER=cristorey
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432

# --- Correo (avisos a las familias). Vacío = se imprime en consola ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=Cristo Rey <no-reply@cristorey.local>
